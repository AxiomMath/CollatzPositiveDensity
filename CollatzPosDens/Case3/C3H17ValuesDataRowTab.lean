/-- The entry `(p_d, T₁, M₁, m₁, T₃, M₃, m₃)` of the row `(c, o)`. -/
def rowEntry (c o : ℕ) : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ :=
  match rowTab.find? (fun e => e.1 == c && e.2.1 == o) with
  | some e => e.2.2
  | none => (1, 0, 0, 0, 0, 0, 0)

/-- The orbit mean of the row `(c, o)` for the phase class of `s`, read from the table: the class
of `1` for `s ∈ {1, 7}` and the class of `3` otherwise. -/
def meanVal (s c o : ℤ) : ℚ :=
  if s = 1 ∨ s = 7 then
    ((rowEntry c.toNat o.toNat).2.1 : ℚ) / (2 ^ 14 * (10 ^ 8 * (rowEntry c.toNat o.toNat).1))
  else ((rowEntry c.toNat o.toNat).2.2.2.2.1 : ℚ) /
    (2 ^ 14 * (10 ^ 8 * (rowEntry c.toNat o.toNat).1))

/-- The orbit range of the row `(c, o)` for the phase class of `s`, read from the table. -/
def rangeVal (s c o : ℤ) : ℚ :=
  if s = 1 ∨ s = 7 then
    (((rowEntry c.toNat o.toNat).2.2.1 : ℚ) - (rowEntry c.toNat o.toNat).2.2.2.1) /
      (2 ^ 14 * (10 ^ 8 * (rowEntry c.toNat o.toNat).1))
  else (((rowEntry c.toNat o.toNat).2.2.2.2.2.1 : ℚ) - (rowEntry c.toNat o.toNat).2.2.2.2.2.2) /
    (2 ^ 14 * (10 ^ 8 * (rowEntry c.toNat o.toNat).1))

/-- The orbit means and ranges of the row `(c, o)` are the table values, for
`s ∈ {1, 3, 5, 7}`. -/
def RowMR (c o : ℕ) : Prop :=
  ∀ s ∈ ({1, 3, 5, 7} : Finset ℤ),
    c3H17Mean c o s = meanVal s c o ∧ c3H17Range c o s = rangeVal s c o

/-- The table mean for `s = 7` is the table mean for `s = 1`. -/
theorem meanVal_seven (c o : ℤ) : meanVal 7 c o = meanVal 1 c o := by simp [meanVal]

/-- The table mean for `s = 5` is the table mean for `s = 3`. -/
theorem meanVal_five (c o : ℤ) : meanVal 5 c o = meanVal 3 c o := by simp [meanVal]

/-- The table range for `s = 7` is the table range for `s = 1`. -/
theorem rangeVal_seven (c o : ℤ) : rangeVal 7 c o = rangeVal 1 c o := by simp [rangeVal]

/-- The table range for `s = 5` is the table range for `s = 3`. -/
theorem rangeVal_five (c o : ℤ) : rangeVal 5 c o = rangeVal 3 c o := by simp [rangeVal]

/-- The orbit means and ranges of `s = 1, 3, 5, 7`, and the table values of the classes of `1`
and `3`, give `RowMR`. -/
theorem rowMR_of {c o pd T1 M1 m1 T3 M3 m3 : ℕ}
    (h : (c3H17Mean c o 1 = (T1 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 1 = ((M1 : ℚ) - m1) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 3 = (T3 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 3 = ((M3 : ℚ) - m3) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 5 = (T3 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 5 = ((M3 : ℚ) - m3) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 7 = (T1 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 7 = ((M1 : ℚ) - m1) / (2 ^ 14 * (10 ^ 8 * pd))))
    (e1 : meanVal 1 c o = (T1 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)))
    (e2 : rangeVal 1 c o = ((M1 : ℚ) - m1) / (2 ^ 14 * (10 ^ 8 * pd)))
    (e3 : meanVal 3 c o = (T3 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)))
    (e4 : rangeVal 3 c o = ((M3 : ℚ) - m3) / (2 ^ 14 * (10 ^ 8 * pd))) : RowMR c o := by
  intro s hs
  simp only [Finset.mem_insert, Finset.mem_singleton] at hs
  obtain ⟨⟨a1, b1⟩, ⟨a3, b3⟩, ⟨a5, b5⟩, ⟨a7, b7⟩⟩ := h
  rcases hs with rfl | rfl | rfl | rfl
  · exact ⟨a1.trans e1.symm, b1.trans e2.symm⟩
  · exact ⟨a3.trans e3.symm, b3.trans e4.symm⟩
  · exact ⟨a5.trans (meanVal_five _ _ ▸ e3.symm), b5.trans (rangeVal_five _ _ ▸ e4.symm)⟩
  · exact ⟨a7.trans (meanVal_seven _ _ ▸ e1.symm), b7.trans (rangeVal_seven _ _ ▸ e2.symm)⟩

/-- `rowMR_of`, with the four table values read off a single natural-number equation for the
table entry `rowEntry c o`, so that no rational arithmetic is evaluated. -/
theorem rowMR_of_rowEntry {c o pd T1 M1 m1 T3 M3 m3 : ℕ}
    (h : (c3H17Mean c o 1 = (T1 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 1 = ((M1 : ℚ) - m1) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 3 = (T3 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 3 = ((M3 : ℚ) - m3) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 5 = (T3 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 5 = ((M3 : ℚ) - m3) / (2 ^ 14 * (10 ^ 8 * pd))) ∧
    (c3H17Mean c o 7 = (T1 : ℚ) / (2 ^ 14 * (10 ^ 8 * pd)) ∧
      c3H17Range c o 7 = ((M1 : ℚ) - m1) / (2 ^ 14 * (10 ^ 8 * pd))))
    (he : rowEntry c o = (pd, T1, M1, m1, T3, M3, m3)) : RowMR c o := by
  refine rowMR_of h ?_ ?_ ?_ ?_
  · rw [meanVal, ite_eq_left (by decide), Int.toNat_natCast, Int.toNat_natCast, he]
  · rw [rangeVal, ite_eq_left (by decide), Int.toNat_natCast, Int.toNat_natCast, he]
  · rw [meanVal, ite_eq_right (by decide), Int.toNat_natCast, Int.toNat_natCast, he]
  · rw [rangeVal, ite_eq_right (by decide), Int.toNat_natCast, Int.toNat_natCast, he]

end C3H17Values

