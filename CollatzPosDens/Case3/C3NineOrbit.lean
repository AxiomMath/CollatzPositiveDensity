module

public import CollatzPosDens.Case3.C3NineValuation
public import Mathlib.Data.ZMod.Units
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Index
public import Mathlib.RingTheory.Int.Basic
public import Mathlib.FieldTheory.Finite.Basic

/-!
# The orbit of multiplication by `9` modulo a power of two

Let `j : ℕ`. Every odd residue modulo `2 ^ (j + 3)` is reached from any other residue in the same
class modulo `8` by multiplying by a power `9 ^ a` with `a < 2 ^ j`: if `M` and `s` are integers,
`s` odd and `M ≡ s [ZMOD 8]`, then `M ≡ 9 ^ a * s [ZMOD 2 ^ (j + 3)]` for some `a < 2 ^ j`.

The proof is a counting argument in the unit group `(ZMod (2 ^ (j + 3)))ˣ`. Since
`v₂ (9 ^ 2 ^ j - 1) = j + 3`, the unit `9` has order exactly `2 ^ j`. Its cyclic subgroup lies in
the kernel of reduction modulo `8`, because `9 ≡ 1 [MOD 8]`. Reduction modulo `8` is surjective on
units, so this kernel has `φ (2 ^ (j + 3)) / φ 8 = 2 ^ j` elements, and the cyclic subgroup is the
whole kernel. The unit `M * s⁻¹` lies in the kernel, hence is `9 ^ a` with `a < 2 ^ j`.

## Main results

* `CollatzPosDens.exists_nine_pow_mul_modEq_two_pow`: for every `j`, `M ≡ 9 ^ a * s` modulo
  `2 ^ (j + 3)` for some `a < 2 ^ j`.
* `CollatzPosDens.exists_nine_pow_mul_modEq`: the case `j = 14`, modulo `2 ^ 17`.

## Implementation notes

Only `s` is assumed odd: oddness of `M` follows from `M ≡ s [ZMOD 8]`. Rather than counting the
residues `9 ^ k * s` directly, the argument counts the elements of a kernel in the unit group.

## References

* [Mazur, *Explicit Positive-Density Collatz Convergence in Logarithmic Time*][mazur2026]
-/

@[expose] public section

namespace CollatzPosDens

/-- The unit `9` of `ZMod (2 ^ (j + 3))` has order `2 ^ j`. -/
theorem orderOf_nine_unit_two_pow (j : ℕ) :
    orderOf (ZMod.unitOfCoprime 9 (Nat.Coprime.pow_right _ (by decide)) :
      (ZMod (2 ^ (j + 3)))ˣ) = 2 ^ j := by
  set u : (ZMod (2 ^ (j + 3)))ˣ := ZMod.unitOfCoprime 9 (Nat.Coprime.pow_right _ (by decide))
  have key : ∀ k : ℕ, u ^ k = 1 ↔ 2 ^ (j + 3) ∣ 9 ^ k - 1 := fun k ↦ by
    rw [← Units.val_inj, Units.val_pow_eq_pow_val, ZMod.coe_unitOfCoprime, Units.val_one,
      ← Nat.modEq_iff_dvd' (Nat.one_le_pow _ _ (by norm_num)), Nat.ModEq.comm,
      ← ZMod.natCast_eq_natCast_iff]
    push_cast
    rfl
  rcases j with _ | i
  · rw [pow_zero, orderOf_eq_one_iff]
    have h := (key 1).2 (by decide)
    rwa [pow_one] at h
  · refine orderOf_eq_prime_pow ?_ ?_
    · rw [key]
      exact not_two_pow_dvd_nine_pow_two_pow_sub_one i
    · rw [key]
      exact two_pow_dvd_nine_pow_two_pow_sub_one (i + 1)

/-- Let `s` be odd and `M ≡ s [ZMOD 8]`. Then for every `j`, `M ≡ 9 ^ a * s [ZMOD 2 ^ (j + 3)]`
for some `a < 2 ^ j`. -/
theorem exists_nine_pow_mul_modEq_two_pow (j : ℕ) {M s : ℤ} (hs : Odd s)
    (hMs : M ≡ s [ZMOD 8]) : ∃ a : ℕ, a < 2 ^ j ∧ M ≡ 9 ^ a * s [ZMOD 2 ^ (j + 3)] := by
  set n : ℕ := 2 ^ (j + 3) with hn
  have h8 : 8 ∣ n := ⟨2 ^ j, by rw [hn, pow_add]; ring⟩
  set φ : (ZMod n)ˣ →* (ZMod 8)ˣ := ZMod.unitsMap h8
  set u : (ZMod n)ˣ := ZMod.unitOfCoprime 9 (Nat.Coprime.pow_right _ (by decide))
  have hM : Odd M := by
    have := hMs.symm.dvd
    rcases hs with ⟨k, rfl⟩
    obtain ⟨c, hc⟩ := this
    exact ⟨k + 4 * c, by omega⟩
  have hcop : ∀ x : ℤ, Odd x → IsCoprime x (n : ℤ) := fun x hx ↦ by
    rw [hn, Nat.cast_pow, Nat.cast_ofNat]
    exact (Int.isCoprime_two_right.2 hx).pow_right
  set uM : (ZMod n)ˣ := ZMod.unitOfIsCoprime M (hcop M hM)
  set us : (ZMod n)ˣ := ZMod.unitOfIsCoprime s (hcop s hs)
  -- the kernel of reduction modulo `8` has `2 ^ j` elements
  have hcardK : Nat.card φ.ker = 2 ^ j := by
    have h1 := φ.ker.card_mul_index
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.2 (ZMod.unitsMap_surjective h8),
      Subgroup.card_top,
      Nat.card_eq_fintype_card (α := (ZMod 8)ˣ), Nat.card_eq_fintype_card (α := (ZMod n)ˣ),
      ZMod.card_units_eq_totient,
      ZMod.card_units_eq_totient] at h1
    have htot : n.totient = 2 ^ j * Nat.totient 8 := by
      rw [hn, Nat.totient_prime_pow Nat.prime_two (by omega),
        show (8 : ℕ) = 2 ^ 3 by norm_num, Nat.totient_prime_pow Nat.prime_two (by omega)]
      rw [show j + 3 - 1 = j + (3 - 1) by omega, pow_add]
      ring
    rw [htot] at h1
    exact Nat.eq_of_mul_eq_mul_right (by norm_num) h1
  -- it is the cyclic subgroup generated by `9`
  have hK : Subgroup.zpowers u = φ.ker := by
    refine Subgroup.eq_of_le_of_card_ge ?_ ?_
    · rw [Subgroup.zpowers_le, MonoidHom.mem_ker, ← Units.val_inj, ZMod.unitsMap_val,
        ZMod.coe_unitOfCoprime, ZMod.cast_natCast h8]
      rfl
    · rw [hcardK, Nat.card_zpowers, orderOf_nine_unit_two_pow]
  have hmem : uM * us⁻¹ ∈ φ.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, mul_inv_eq_one, ← Units.val_inj, ZMod.unitsMap_val,
      ZMod.unitsMap_val, ZMod.coe_unitOfIsCoprime, ZMod.coe_unitOfIsCoprime, ZMod.cast_intCast h8,
      ZMod.cast_intCast h8, ZMod.intCast_eq_intCast_iff]
    exact hMs
  rw [← hK, ← mem_powers_iff_mem_zpowers, mem_powers_iff_mem_range_orderOf] at hmem
  obtain ⟨a, ha, hau⟩ := Finset.mem_image.1 hmem
  refine ⟨a, ?_, ?_⟩
  · rwa [Finset.mem_range, orderOf_nine_unit_two_pow] at ha
  · rw [show ((2 : ℤ) ^ (j + 3)) = ((n : ℕ) : ℤ) by rw [hn]; push_cast; rfl,
      ← ZMod.intCast_eq_intCast_iff]
    have := congrArg (fun x : (ZMod n)ˣ ↦ ((x * us : (ZMod n)ˣ) : ZMod n)) hau
    simp only [inv_mul_cancel_right, Units.val_mul, Units.val_pow_eq_pow_val] at this
    rw [show (u : ZMod n) = 9 from ZMod.coe_unitOfCoprime _ _,
      show (us : ZMod n) = s from rfl, show (uM : ZMod n) = M from rfl] at this
    push_cast
    exact this.symm

/-- Let `M` and `s` be odd integers with `M ≡ s [ZMOD 8]`. Then
`M ≡ 9 ^ a * s [ZMOD 2 ^ 17]` for some `0 ≤ a < 2 ^ 14`. -/
@[collatz_pos_dens "lem_c3_nine_orbit"]
theorem exists_nine_pow_mul_modEq {M s : ℤ} (_hM : Odd M) (hs : Odd s)
    (hMs : M ≡ s [ZMOD 8]) : ∃ a : ℕ, a < 2 ^ 14 ∧ M ≡ 9 ^ a * s [ZMOD 2 ^ 17] :=
  exists_nine_pow_mul_modEq_two_pow 14 hs hMs

end CollatzPosDens
